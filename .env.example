# Get a free personal key: log in at https://api.sap.com, open any S/4HANA Cloud API,
# go to "Try Out", and click "Show API Key".
SAP_API_KEY=your-sandbox-api-key

# Defaults to SAP Business Accelerator Hub sandbox. Change later to point at a BTP trial
# or your own system (never a client system!).
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap

# Hard cap on rows returned to the AI per call (keeps context windows sane).
SAP_MAX_ROWS=50
